{
  "expo": {
    "name": "Pantami Impact Tracker",
    "slug": "pantami-impact-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pantami-impact",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abzdevs.pantami"
    },
    "android": {
      "package": "com.abzdevs.pantami",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC1HvQ_IqqeFYawV3nYY6WSU8BYZBfXAIQ"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#008751",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          // "androidAppId": "ca-app-pub-4816714934569245~7254666844",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "./plugins/withAdMobFix"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d2e4ed1-3cdb-48de-a0b9-03fd7c281855"
      }
    }
  }
}